    {
      "parameters": {
        "jsCode": "const queries = [\n  \"agence digitale Montpellier\",\n  \"agence SEO Hérault\",\n  \"agence web Nîmes\",\n  \"agence communication Montpellier\",\n  \"création site web Hérault\",\n  \"agence marketing digital Gard\",\n  \"agence réseaux sociaux Montpellier\",\n  \"agence SEO Nîmes\",\n  \"agence web Béziers\",\n  \"agence digitale Sète\"\n];\n\nreturn queries.map(q => ({ json: { query: q } }));"
      },
      "id": "a2222222-2222-2222-2222-222222222222",
      "name": "Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1400, 0]
    },
    {
      "parameters": {
        "options": {}
      },
