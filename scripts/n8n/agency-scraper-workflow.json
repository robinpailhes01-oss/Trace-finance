      "id": "b2222222-2222-2222-2222-222222222222",
      "name": "Fetch Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 300,\n  \"system\": \"Tu es un extracteur de données. Analyse le HTML d'un site web et retourne UNIQUEMENT un objet JSON valide, sans aucun texte autour.\\nFormat attendu :\\n{\\\"email\\\": \\\"adresse@exemple.fr\\\", \\\"activite\\\": \\\"description courte en 5 mots max\\\"}\\nSi aucun email n'est trouvé, retourne : {\\\"email\\\": null, \\\"activite\\\": \\\"agence digitale\\\"}\\nNe retourne rien d'autre que ce JSON.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Voici le HTML du site ' + $('Loop Over Leads').item.json.website + ' :\\n\\n' + (($json.data || '') + '').substring(0, 8000)) }}\n    }\n  ]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b3333333-3333-3333-3333-333333333333",
      "name": "Claude - Extract Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 0]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.content[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { email: null, activite: 'agence digitale' };\n}\nreturn [{\n  json: {\n    email: parsed.email || null,\n    activite: parsed.activite || 'agence digitale'\n  }\n}];"
      },
      "id": "b4444444-4444-4444-4444-444444444444",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-email",
              "name": "email",
              "value": "={{ null }}",
              "type": "string"
            },
            {
              "id": "set-activite",
              "name": "activite",
              "value": "agence digitale",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b5555555-5555-5555-5555-555555555555",
      "name": "Set Defaults",
