        "url": "=https://api.apify.com/v2/acts/nwua9Gu5YrADL7ZDj/runs?token={{$credentials.apifyApiToken}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchStringsArray\": [\"{{$json.query}}\"],\n  \"locationQuery\": \"France\",\n  \"maxCrawledPlacesPerSearch\": 40,\n  \"language\": \"fr\",\n  \"exportPlaceUrls\": false,\n  \"includeWebResults\": false\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a4444444-4444-4444-4444-444444444444",
